# Tiền tố lệnh (Mặc định: ! hoặc /, ví dụ: !help, !ai, !music, !stik)
BOT_PREFIX=!

# Tự động trả lời mọi tin nhắn trong chat 1-1 bằng AI (true/false)
# Nếu đặt false, bot chỉ trả lời khi dùng lệnh trực tiếp (ví dụ: !ai <câu hỏi>)
AUTO_REPLY_AI=false

# Google Gemini API Key (Cần thiết cho lệnh !ai và tự động chat AI)
# Lấy API Key hoàn toàn miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Mô hình Gemini sử dụng (mặc định: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Số lượng tin nhắn gần nhất AI sẽ đọc lại để nắm bắt ngữ cảnh cuộc hội thoại (mặc định: 8)
AI_HISTORY_LIMIT=8

# Thời gian nghỉ ngẫu nhiên (miligiây) trước khi phản hồi nhằm mô phỏng người thật, chống checkpoint Facebook
SAFE_DELAY_MIN=2500
SAFE_DELAY_MAX=5000

# Cổng HTTP cho Web Dashboard và Health Check (Render/Railway tự động cấp hoặc mặc định 3000)
PORT=3000

# Dữ liệu phiên đăng nhập Facebook AppState (Tùy chọn)
# Dùng khi deploy lên Render / Railway / Docker: Copy toàn bộ nội dung file appstate.json (dạng JSON hoặc mã hóa Base64) dán vào đây.
# Nếu chạy ở máy tính cá nhân, bạn chỉ cần để file appstate.json ở thư mục gốc của dự án.
FB_APPSTATE=
